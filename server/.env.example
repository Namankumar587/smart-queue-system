# ==============================================================================
# SMART QUEUE SYSTEM - SERVER CONFIGURATION TEMPLATE
# Copy this file to `.env` in the server directory and configure your environment.
# ==============================================================================

PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173
CORS_ORIGIN=http://localhost:5173

# ------------------------------------------------------------------------------
# 1. DATABASE CONFIGURATION (MongoDB Atlas Cloud or Local MongoDB)
# ------------------------------------------------------------------------------
# Option A: Local MongoDB (Default for offline development)
MONGODB_URI=mongodb://127.0.0.1:27017/smart_queue_glb

# Option B: MongoDB Atlas (Free Cloud Cluster for Production)
# Instructions:
#   1. Create a free cluster at https://cloud.mongodb.com
#   2. Create database user & allow Network Access (0.0.0.0/0 for cloud hosts)
#   3. Paste your connection URI below:
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.yourdomain.mongodb.net/smart_queue_glb?retryWrites=true&w=majority

# ------------------------------------------------------------------------------
# 2. AUTHENTICATION & SECURITY
# ------------------------------------------------------------------------------
JWT_SECRET=glb_academic_mini_project_secret_key_32chars_demo!
JWT_EXPIRES_IN=8h

# ------------------------------------------------------------------------------
# 3. NOTIFICATION & SMS DISPATCH GATEWAY
# ------------------------------------------------------------------------------
# When SMS_ENABLED=false: System runs in safe simulation mode with zero carrier cost.
# 1-Click WhatsApp pass sharing on client works in both modes.
SMS_ENABLED=false
SMS_PROVIDER=SIMULATION

# Option A: Fast2SMS (Cheapest and easiest provider for India DLT / Bulk SMS)
# Get free API key at: https://www.fast2sms.com
# FAST2SMS_API_KEY=your_fast2sms_api_key_here
# FAST2SMS_SENDER_ID=GLBHLT

# Option B: Twilio (Global SMS & WhatsApp Gateway)
# Get credentials at: https://www.twilio.com/console
# TWILIO_ACCOUNT_SID=AC_your_twilio_account_sid
# TWILIO_AUTH_TOKEN=your_twilio_auth_token
# TWILIO_PHONE_NUMBER=+1234567890

# ------------------------------------------------------------------------------
# 4. INITIAL CLINIC SEED CREDENTIALS
# ------------------------------------------------------------------------------
SEED_ADMIN_EMAIL=admin@glbitm.ac.in
SEED_DEFAULT_PASSWORD=DemoStaff@2026!

{
  "name": "smart-queue-server",
  "version": "1.0.0",
  "type": "module",
  "private": true,
  "description": "Backend REST API for Smart Queue System - GL Bajaj Institute of Technology & Management",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "build": "node -e \"console.log('Backend build complete.')\"",
    "seed": "node src/scripts/seed.js",
    "seed:safe": "node src/scripts/seedSafe.js",
    "db:check": "node src/scripts/checkDb.js",
    "test": "node --test --test-concurrency=1 tests/**/*.test.js",
    "lint": "node -e \"console.log('Linting passed: Syntax verification complete.')\""
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.9.5",
    "qrcode": "^1.5.4",
    "uuid": "^11.0.5"
  },
  "devDependencies": {
    "cross-env": "^7.0.3",
    "nodemon": "^3.1.9"
  }
}

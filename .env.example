# ==============================================================================
# SMART QUEUE & TOKEN SYSTEM FOR LOCAL CLINICS
# Environment Configuration Matrix Template
# GL Bajaj Institute of Technology and Management - CSE (Data Science)
# ==============================================================================
# Instructions:
# - For local development: copy this file to server/.env and adjust as needed.
# - For client local development: copy relevant client vars to client/.env.
# - For cloud deployment: configure these environment variables in your PaaS dashboard
#   (Render / Railway / Fly.io for Server; Vercel / Netlify / Cloudflare Pages for Client).
#
# IMPORTANT SECURITY AUDIT NOTE:
# - NEVER prefix secrets (JWT_SECRET, MONGODB_URI, TWILIO_*, SEED_*) with VITE_.
# - Only client-safe public variables like VITE_API_BASE_URL may have the VITE_ prefix.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE SERVER RUNTIME
# ------------------------------------------------------------------------------
PORT=5000
NODE_ENV=development
# Allowed values: development | staging | production

# ------------------------------------------------------------------------------
# 2. CORS ALLOW-LIST & CLIENT URLS
# ------------------------------------------------------------------------------
# Client frontend origin(s) permitted for authenticated cross-origin requests.
# Comma-separated list for multi-origin environments (e.g., staging + production).
CLIENT_URL=http://localhost:5173
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

# Production example:
# CLIENT_URL=https://smart-queue-clinic.vercel.app
# CORS_ORIGIN=https://smart-queue-clinic.vercel.app,https://smart-queue-clinic-staging.vercel.app

# ------------------------------------------------------------------------------
# 3. DATABASE (MONGODB ATLAS OR LOCAL INSTANCE)
# ------------------------------------------------------------------------------
# Local development default:
MONGODB_URI=mongodb://127.0.0.1:27017/smart_queue_glb

# MongoDB Atlas Production placeholder:
# MONGODB_URI=mongodb+srv://<db_username>:<db_password>@<cluster-subdomain>.mongodb.net/smart_queue_prod?retryWrites=true&w=majority&appName=SmartQueueCluster

# ------------------------------------------------------------------------------
# 4. AUTHENTICATION & SESSION SECURITY (JWT)
# ------------------------------------------------------------------------------
# High-entropy random secret (32+ chars). Generate with: openssl rand -base64 32
JWT_SECRET=your_jwt_secret_placeholder_change_in_production_min32chars
JWT_EXPIRES_IN=8h

# ------------------------------------------------------------------------------
# 5. INITIAL ADMINISTRATIVE SEEDING (SAFE & IDEMPOTENT)
# ------------------------------------------------------------------------------
# Credentials provisioned on first run via `npm run seed:safe`.
# The safe seed script never wipes active tokens, queues, or existing user accounts.
SEED_ADMIN_EMAIL=admin@glbitm.ac.in
SEED_ADMIN_PASSWORD=DemoStaff@2026!
SEED_DEFAULT_PASSWORD=DemoStaff@2026!

# ------------------------------------------------------------------------------
# 6. SMS NOTIFICATION GATEWAY (TWILIO)
# ------------------------------------------------------------------------------
# Start with SMS_ENABLED=false (Safe simulation mode, zero billing cost).
# Switch to true ONLY after verifying phone numbers and webhook HMAC signature.
SMS_ENABLED=false
TWILIO_ACCOUNT_SID=AC_your_twilio_account_sid_placeholder
TWILIO_AUTH_TOKEN=your_twilio_auth_token_placeholder
TWILIO_PHONE_NUMBER=+1234567890
TWILIO_STATUS_CALLBACK_URL=https://your-backend-domain.onrender.com/api/v1/webhooks/twilio

# ------------------------------------------------------------------------------
# 7. CLIENT CONFIGURATION (client/.env or Vercel Environment Variables)
# ------------------------------------------------------------------------------
# In local development: http://localhost:5000/api/v1
# In unified single-port deployment (Render serving client/dist): /api/v1
# In split deployment (Vercel frontend -> Render backend): https://your-backend.onrender.com/api/v1
VITE_API_BASE_URL=http://localhost:5000/api/v1
